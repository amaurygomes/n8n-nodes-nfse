{
	"name": "n8n-nodes-nfse",
	"version": "0.1.13",
	"publishConfig": {
		"access": "public"
	},
	"description": "Emissor 100% nativo de NFS-e Padrão Nacional (SEFIN/ADN da Receita Federal) para n8n, com certificado A1 e mTLS.",
	"license": "MIT",
	"homepage": "https://www.npmjs.com/package/n8n-nodes-nfse",
	"keywords": [
		"n8n-community-node-package",
		"nfse",
		"nfs-e",
		"nfse-nacional",
		"sefin",
		"receita-federal",
		"nota-fiscal",
		"danfse",
		"brasil",
		"iss"
	],
	"author": {
		"name": "Amaury Gomes Ibanez",
		"email": "amaury_mju@hotmail.com",
		"url": "https://agnez.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amaurygomes/n8n-nodes-nfse.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/NfseNacionalApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/NfseNacional/NfseNacional.node.js"
		]
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.11",
		"node-forge": "^1.3.1",
		"pdfkit": "^0.16.0",
		"qrcode": "^1.5.4",
		"xml-crypto": "^6.1.2"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.14.0",
		"@types/node-forge": "^1.3.11",
		"@types/pdfkit": "^0.13.9",
		"@types/qrcode": "^1.5.5",
		"n8n-workflow": "*",
		"typescript": "~5.5.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
